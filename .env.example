# ── Supabase (required) ─────────────────────────────────────────────────────
# Missing values here fail hard at startup (src/lib/env.ts).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Provide at least one of the three public key names below.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
# Server-only. Required by nearly every API route (service client).
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (required for billing and workshop checkout) ─────────────────────
STRIPE_SECRET_KEY=sk_live_or_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_...
# Required or every incoming Stripe webhook is rejected with a 500.
STRIPE_WEBHOOK_SECRET=whsec_...
# Guards scripts/setup-stripe.mjs against running in the wrong Stripe account.
STRIPE_EXPECTED_ACCOUNT_ID=acct_...
# Optional explicit Price ID overrides; if unset the app resolves active
# prices by lookup key (addition_pro_monthly, addition_pro_yearly, ...).
# STRIPE_PRO_PRICE_ID=price_...
# STRIPE_PRO_YEARLY_PRICE_ID=price_...
# STRIPE_STUDENT_PRICE_ID=price_...
# STRIPE_STUDENT_YEARLY_PRICE_ID=price_...
# Optional; defaults to gbp (used by scripts/setup-stripe.mjs).
# STRIPE_BILLING_CURRENCY=gbp

# ── Cloudflare Stream (required for video upload + gated playback) ──────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=

# ── Resend email (required in production) ───────────────────────────────────
# Without RESEND_API_KEY, workshop confirmation and recording emails are
# skipped (logged as errors, but customers receive nothing).
RESEND_API_KEY=
RESEND_FROM="Addition Academy <workshops@addition.academy>"

# ── OpenAI (required for admin AI generation and student verification) ──────
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.2

# ── Admin access ─────────────────────────────────────────────────────────────
# Comma-separated allow-list of admin emails. Admins can also be added to the
# addition_admins table (migration 0006). If both this and the table are
# empty, nobody can access the admin portal.
CONTENT_STUDIO_ADMIN_EMAILS=
# ADMIN_EMAIL=

# ── Site ─────────────────────────────────────────────────────────────────────
# Defaults to https://addition.academy when unset.
# NEXT_PUBLIC_SITE_URL=https://addition.academy

# ── Launch smoke test (scripts/launch-smoke.mjs, optional) ──────────────────
# LAUNCH_SMOKE_BASE_URL=http://localhost:3000
# LAUNCH_SMOKE_ADMIN_TOKEN=
